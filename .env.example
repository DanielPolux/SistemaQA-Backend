# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=sistema_qa
DB_SSL=false

# JWT
JWT_SECRET=cambia_esto_por_un_secreto_seguro
JWT_EXPIRES_IN=24h

# App
PORT=3000
NODE_ENV=production

# URL del frontend (usada en links de correo)
FRONTEND_URL=https://tu-frontend.vercel.app

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGIN=https://tu-frontend.vercel.app

# Mail (SMTP vía Brevo — https://app.brevo.com/settings/keys/smtp)
# NOTA: usar smtp-relay.sendinblue.com, no smtp-relay.brevo.com — el certificado TLS que
# entrega el edge de Brevo solo cubre *.sendinblue.com, así que brevo.com falla la
# verificación de hostname (error "Hostname/IP does not match certificate's altnames").
MAIL_HOST=smtp-relay.sendinblue.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=tu-login-de-brevo
MAIL_PASS=tu-smtp-key-de-brevo
MAIL_FROM=Sistema QA <remitente-verificado@tu-dominio-o-brevo.com>
